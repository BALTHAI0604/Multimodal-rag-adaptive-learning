# Copy to .env (git-ignored). Nothing here is a real credential.
ENVIRONMENT=development            # development | test | production

# ---- Authentication --------------------------------------------------------------
# local   = development only (bcrypt + locally signed tokens; no Firebase project needed)
# firebase = REQUIRED in production
AUTH_MODE=local
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=              # public web API key from Firebase console > Project settings
GOOGLE_APPLICATION_CREDENTIALS=    # path to a service-account JSON kept OUTSIDE the repository
FIREBASE_AUTH_EMULATOR_HOST=       # e.g. 127.0.0.1:9099 (free local emulator, never in production)
FIRESTORE_SYNC=false
REQUIRE_EMAIL_VERIFIED=true
COOKIE_SECURE=false                # true when served over HTTPS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=true                # serve the built UI (frontend/dist) from the API on one port

# ---- Keys: generate with  python -m app.cli gen-keys  ----------------------------
DATA_ENCRYPTION_KEY=
BLOCKCHAIN_HMAC_KEY=

# ---- AI / RAG (all free & local) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_BACKEND=auto             # auto | sentence_transformers | hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-small
WHISPER_MODEL=small
OCR_LANGS=eng                      # e.g. eng+tam+hin when those tesseract language packs are installed
PIPER_BIN=piper
PIPER_VOICES_DIR=
PIPER_VOICE_EN=
PIPER_VOICE_HI=
PIPER_VOICE_TA=
PIPER_VOICE_KN=
PIPER_VOICE_ML=

# ---- Blockchain (local Hardhat node) ---------------------------------------------
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=                  # printed by: python -m app.cli deploy-contract
BLOCKCHAIN_PRIVATE_KEY=            # empty => the node's unlocked account #0 (local dev only)

# ---- Privacy ----------------------------------------------------------------------
VOICE_STORE_AUDIO=false
CONVERSATION_RETENTION_DAYS=90
